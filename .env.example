# Get Linked Environment Variables
# Domains: getlinkedlk.com | getlinked.today

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Authentication Secret
AUTH_SECRET="super-secret-key-change-in-production-minimum-32-chars"
ADMIN_DEFAULT_PASSWORD="your-secure-admin-password"
NEXT_PUBLIC_ADMIN_PASSWORD="your-secure-admin-password"

# Supabase Public Frontend Credentials
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key"

# Supabase Private Backend Credentials (Server-side only)
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Google Drive Backend Media Storage Integration
# Project ID: getlinked-511108
GOOGLE_DRIVE_FOLDER_ID="1F2xh_ii87HDSCW3PHFHLXY7DpN_qfkOX"
GOOGLE_DRIVE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_DRIVE_CLIENT_SECRET="your-google-oauth-client-secret"
GOOGLE_DRIVE_REFRESH_TOKEN="your-google-oauth-offline-refresh-token"
GOOGLE_DRIVE_API_KEY="your-public-google-api-key"

# Storage Configuration (Private storage for ID/passports)
STORAGE_PROVIDER="local" # "local" | "s3" | "supabase"
PRIVATE_STORAGE_PATH="./storage/private_documents"
PUBLIC_STORAGE_BUCKET="getlinked-public-assets"

# Sri Lanka PDPA Compliance & Retention
DEFAULT_DOCUMENT_RETENTION_DAYS="90"
CREATOR_POOL_LIMIT="1000"
PLATFORM_PHASE="FREE" # "FREE" | "PAID"
BILLING_MODE="none" # "none" | "per_match" | "subscription"
